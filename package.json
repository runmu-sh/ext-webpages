{
  "name": "@runmu.sh/ext-webpages",
  "version": "1.1.0",
  "description": "Lets the game open web pages in your client over GMCP Client.Web.Open (a Web tab per page, or a new window, per your Access → Open web pages setting).",
  "keywords": [
    "web",
    "iframe",
    "gmcp",
    "web_panel"
  ],
  "license": "MIT",
  "homepage": "https://runmu.sh/marketplace/x/webpages",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runmu-sh/ext-webpages.git"
  },
  "bugs": {
    "url": "https://github.com/runmu-sh/ext-webpages/issues"
  },
  "type": "module",
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "src/types.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/build.mjs --check",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@muclient/sdk": "npm:@runmu.sh/sdk@^1.12.0",
    "@runmu.sh/dev": "^0.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "muclient": {
    "id": "webpages",
    "api": "^1.12",
    "source": "src/index.ts",
    "displayName": "Web pages",
    "description": "Lets the game open web pages in your client over GMCP Client.Web.Open (a Web tab per page, or a new window, per your Access → Open web pages setting).",
    "categories": [
      "interface"
    ],
    "contributes": {
      "gmcp": [
        {
          "package": "Client.Web 1",
          "messages": {
            "Client.Web.Open": {
              "dir": "in",
              "schema": {
                "type": [
                  "object",
                  "string"
                ],
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "id": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "title": {
                    "type": "string"
                  }
                }
              }
            },
            "Client.Web.Close": {
              "dir": "in",
              "schema": {
                "type": [
                  "object",
                  "string"
                ],
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "number"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "capabilities": [
      "open-web"
    ],
    "publisher": "bitmuse"
  },
  "types": "./src/types.ts"
}
